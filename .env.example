# ================== RPC (required) ==================
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_API_KEY=            # optional, the bots only need RPC_URL
RPC_TIMEOUT_MS=15000          # per-request RPC timeout, 1000..120000 ms
# RPC_MAX_RPS=               # max RPC requests per second; empty = code default

# ================== RPC failover (shadow + census only; RPC_URL stays required) ==================
# Several endpoints, order = priority; one per line; "http_url|ws_url" when the websocket lives elsewhere.
# Ignored by live bots and every other process.
# RPC_URLS=[
#   https://provider.example/YOUR_KEY_1
#   https://provider.example/YOUR_KEY_2|wss://provider-ws.example/YOUR_KEY_2
# ]                             # each key once: a duplicate stops shadow / census at the start
# RPC_FAILOVER_AFTER=3          # limit signals in a row (401/402/403/429, limit errors) before switching, 1..100
# RPC_FAILOVER_COOLDOWN_MIN=60  # an exhausted (out of credits) endpoint is retried after this, 0..10080 min
# RPC_FAILOVER_UNREACH_MIN=2    # an unreachable (no connect 60 s) or thin endpoint is retried after this, 0..60 min

# ================== Network fees and slippage ==================
SLIPPAGE_BPS=500              # 5% price tolerance on buy/sell (0..1500)
CU_PRICE=1500000              # micro-lamports per compute unit
CU_LIMIT=120000               # priority fee = CU_PRICE*CU_LIMIT/1e6 = 180,000 lamports ~ 0.00018 SOL/tx
                              # watch unitsConsumed in the journal: an AMM sell may not fit in 120k
SLIPPAGE_ASSUMED_BPS=50       # dry-run cost model. DO NOT CHANGE: journals would stop being comparable

# ================== Hard limits (live trading) ==================
MAX_TRADE_SOL=0.02            # max SOL per single buy (= the bet size)
MAX_SESSION_SOL=0.3           # was 200 (= no limit). 0.3 ~ 15 entries of 0.02 per session
MAX_CONSEC_LOSSES=5           # was 500 (= no limit). Stop after 5 losses in a row
DAILY_LOSS_LIMIT_SOL=0.05     # graduation: no new buys after -0.05 SOL in a day (Moscow time)

# ================== Misc ==================
CURVE_CACHE_MS=0              # bonding-curve state cache TTL in ms (0 = off)
LOG_LEVEL=info                # debug | info | warn | error
ANALYTICS_PORT=3000

# ================== Sniper ==================
SNIPER_BUY_SOL=0.02
SNIPER_TAKE_PROFIT=2.0
SNIPER_STOP_LOSS=0.5
SNIPER_TIMEOUT_SEC=120
SNIPER_MAX_POSITIONS=3
SNIPER_MIN_DEV_BUY=0
SNIPER_COOLDOWN_SEC=10
SNIPER_MIN_HOLDERS=50         # strict filter: expect very few entries
SNIPER_HOLDER_WAIT_SEC=60
SNIPER_MIN_SLOTS=1
SNIPER_MIN_DELAY_MS=0
SNIPER_POST_EXIT_SEC=300      # seconds to keep sampling the price after an exit (journal only)

# ================== Copy trader ==================
COPY_TARGETS=wallet1,wallet2  # put the real wallet addresses here, comma-separated
COPY_BUY_SOL=0.02
COPY_SELL_PCT=100
COPY_MAX_POSITIONS=5
# COPY_SIZE_MODE=fixed         # proportional = buy the same share of our wallet the target spent of its wallet
# COPY_RESERVE_SOL=0.01        # proportional: kept aside for fees / token-account rent
# COPY_MIN_BUY_SOL=0.005       # proportional: a smaller buy is skipped

# ================== Graduation sniper ==================
GRAD_BUY_SOL=0.02
GRAD_MIN_FILL_PCT=75
GRAD_MAX_FILL_PCT=90
GRAD_MIN_HOLDERS=5
GRAD_TAKE_PROFIT=1.5
GRAD_STOP_LOSS=0.7
GRAD_TIMEOUT_SEC=300
GRAD_MAX_POSITIONS=5
GRAD_COOLDOWN_SEC=30
MAX_TOP10_SHARE=0             # MUST stay 0: any other value blocks ALL buys
EXIT_MIN_RATIO=0.9            # skip an entry whose instant exit returns < 90% of the bet
BUY_SLIPPAGE_BPS=500
SELL_MAX_ATTEMPTS=3
SELL_MAX_SLIPPAGE=2000        # sell slippage grows 500 -> 1000 -> 2000 bps per attempt
OPENING_STALE_SEC=120
SELL_ON_EXIT=yes              # on Ctrl+C with --live, sell this session's own positions
EXIT_TIMEOUT_SEC=60

# ================== Shadow lab (paper only) ==================
SHADOW_BUY_SOL=0.02
SHADOW_SL=0.7
SHADOW_HOLD_SEC=300

# ================== Mint census (read-only recorder) ==================
# CENSUS_THIN_GAPS=3            # with RPC_URLS: this many stream gaps in 10 min on one endpoint = thin -> switch; 0 = off
# CENSUS_POOL_LOGS_SEC=900      # a pool's logs subscription ends this many s after its first pool trade
# CENSUS_POOL_LOGS_MB=40        # ...or after this many MB of its logs; then vault accountSubscribe
# CENSUS_POOL_VAULTS=1          # 0 = no vault phase, pool logs for the whole watch (rev 3 behaviour)
# CENSUS_POOL_VAULT_CHECK=0     # 1 = measure the vault price against trade events from the first pool trade
# CENSUS_PATH=1                # census_path rows (per-second curve path of mints reaching the fill below); 0 = off
# CENSUS_PATH_MIN_FILL=25      # a mint gets a census_path row when its fill reaches this (1..100)
# CENSUS_PATH_MAX_SEC=3600     # the path stops this many s after the threshold second
# CENSUS_PATH_MAX_BUCKETS=4000 # at most this many seconds-with-trades per mint (first ones kept, truncated: true)

# ================== elon-watch (research / paper only, npm run elon) ==================
# X_BEARER_TOKEN=YOUR_X_API_BEARER_TOKEN   # X API v2 pay-per-use app bearer token (never logged)
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY     # only for ELON_VISION=1 (image text via claude-haiku-5-5)
# X_PROVIDER=api               # api (poll) | stream (filtered stream, falls back to api) | replay (X_REPLAY_FILE)
# X_POLL_MS=2000               # poll interval (min 1000; raised automatically from x-rate-limit headers)
# X_PRICE_PER_POST=0.005       # USD per post read (estimate; the developer console is the truth)
# X_DAILY_BUDGET_USD=1.00      # per UTC day, shared by npm run elon and scripts/elon-fetch.mjs
# ELON_FOLLOW_SEC=1800         # follow matched mints / match new creates this long after a post
# ELON_META=1                  # fetch the metadata uri of matched mints ("linked" to the post)
# ELON_VISION=0                # 1 = read attached images with Claude (needs ANTHROPIC_API_KEY)

# NEVER put these in .env (set them per run in the shell only):
#   LIVE_CONFIRM, LIVE_CONFIRM_AMM, DRY_SELL
# Do NOT set MIN_FILL / MAX_FILL / MIN_HOLDERS here: graduation reads them BEFORE the GRAD_* values.


#node bots/graduation-sniper/shadow.mjs

# $env:LIVE_CONFIRM="yes"; $env:LIVE_CONFIRM_AMM="yes"; $env:SELL_ON_EXIT="yes"; npm run graduation -- --live
# Remove-Item Env:LIVE_CONFIRM, Env:LIVE_CONFIRM_AMM, Env:SELL_ON_EXIT