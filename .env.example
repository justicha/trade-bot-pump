# Required — no public fallback. Use your own endpoint (e.g. Helius).
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# Execution mode is DRY-RUN by default. Pass --live on the CLI to trade real SOL.

# Slippage / compute
SLIPPAGE_BPS=500
CU_PRICE=1500000
CU_LIMIT=120000
# CU_LIMIT must stay high enough: a pump buy with Token-2022 TransferChecked + track_volume
# exceeds 80k CUs ("exceeded CUs meter" / ProgramFailedToComplete). 300000 is a safe default.
# priority fee = CU_PRICE*CU_LIMIT/1e6 lamports; must be <= 0.002 SOL (2,000,000 lamports)
#
# Hard per-request deadline for every HTTP RPC call (ms). A throttled endpoint can accept the
# connection and never answer: without a deadline the call never settles, the bot keeps its entry
# slot busy and silently stops trading while the process stays alive.
# RPC_TIMEOUT_MS=15000
#
# Entry/exit reliability (lib/exec.mjs + graduation-sniper):
# EXIT_MIN_RATIO=0.9        # skip an entry whose immediate round trip returns < 90% of the buy
# SELL_MAX_ATTEMPTS=3       # then the position is marked STUCK (no endless retries)
# SELL_MAX_SLIPPAGE=2000    # bps cap for the growing sell slippage (500 -> 1000 -> 2000)
# BUY_SLIPPAGE_BPS=500      # headroom on max_sol_cost (without it every tick up = Custom 6002)

# Hard safety limits. Breaching them ENDS the session: the bot stops listening, closes open
# positions (LIVE only), prints a session summary (SOL spent / SOL received / net) and exits.
#   MAX_TRADE_SOL     — per-trade cap. A trade above it is skipped; the bot keeps running.
#                       0 = block every trade (fail-safe, not "unlimited").
#   MAX_SESSION_SOL   — total SOL the session may put into buys. Exhausted -> session ends.
#                       0 = no session cap (long runs). Keep it several times larger than one buy (0.02 SOL):
#                       a single trade must not be able to exhaust the whole session budget.
#   MAX_CONSEC_LOSSES — N losing trades in a row -> session ends. 0 = no loss limit.
MAX_TRADE_SOL=0.05
MAX_SESSION_SOL=0.1
MAX_CONSEC_LOSSES=3

# Bonding-curve state cache TTL in ms (0 disables caching)
CURVE_CACHE_MS=0

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Sniper config
SNIPER_BUY_SOL=0.02
SNIPER_TAKE_PROFIT=2.0
SNIPER_STOP_LOSS=0.5
SNIPER_TIMEOUT_SEC=120
SNIPER_MAX_POSITIONS=3
SNIPER_MIN_DEV_BUY=0.5
SNIPER_COOLDOWN_SEC=10
# Opt-in auto-stop for bounded runs / the smoke test: stop after N seconds and print the summary.
# Unset = run until Ctrl+C.
# SNIPER_MAX_SEC=60
# Holder gate: do not buy a brand-new token until N distinct wallets hold it
# (2-3 holders = dev + his own wallets). 0 = buy immediately at create (old behaviour).
SNIPER_MIN_HOLDERS=4
# How long to keep counting holders before the token is dropped as a dud/scam.
SNIPER_HOLDER_WAIT_SEC=45
# Organic crowd requirement: distinct buy slots and a minimum delay after the create.
# 1 / 0 keeps the previous behaviour; raise them only after the research lab shows an edge.
SNIPER_MIN_SLOTS=1
SNIPER_MIN_DELAY_MS=0
# Trade journal: after a sell, keep sampling the token price for N seconds to measure whether
# the exit was too early (0 = off). Writes data/journal/YYYY-MM-DD.jsonl, read it with
# `npm run journal`.
SNIPER_POST_EXIT_SEC=300

# SOL/USD is fetched automatically (dexscreener, then coinbase) to print dollar prices.
# Set SOL_PRICE_SOURCE=off to disable those hosts entirely and use SOL_USD only.
# Set this only to force a fixed rate when you have no internet access to those APIs.
# SOL_USD=190
# SOL_PRICE_SOURCE=off

# Copy trader config
COPY_TARGETS=wallet1,wallet2
COPY_BUY_SOL=0.05
COPY_SELL_PCT=100
COPY_MAX_POSITIONS=5

# Graduation sniper config
GRAD_BUY_SOL=0.02
# Entry filters: fill is % of the 85 SOL REAL reserves (a normal curve is ~115 SOL virtual at
# graduation, so a virtual-based fill overstates it by ~35%).
# Each filter accepts its short alias or the GRAD_-prefixed name; the short alias wins if both set.
GRAD_MIN_FILL_PCT=92      # alias MIN_FILL
GRAD_MAX_FILL_PCT=97      # alias MAX_FILL — do not enter the last 3% before migration
GRAD_MIN_HOLDERS=7        # alias MIN_HOLDERS — distinct buyers since first sighting (lower bound)
# MAX_TOP10_SHARE=0       # 0 = off; the trade stream carries no token balances
GRAD_TAKE_PROFIT=1.5
GRAD_STOP_LOSS=0.7
GRAD_TIMEOUT_SEC=300
GRAD_MAX_POSITIONS=3
GRAD_COOLDOWN_SEC=30
# Watchdog for a single entry: if its RPC call never settles, the slot is released with an ALERT
# instead of silently blocking every later candidate.
# OPENING_STALE_SEC=120

# Cost model for dry-run accounting (the session report shows NET before and after costs)
SLIPPAGE_ASSUMED_BPS=50

# Research lab — paper trading only, never sends transactions (bots/research/lab.mjs)
LAB_BUY_SOL=0.02
LAB_MIN_HOLDERS=4
LAB_MIN_SLOTS=2
LAB_MIN_DELAY_MS=2500
LAB_WAIT_SEC=45
LAB_SAMPLES=30,60,120,300
# Execution latency: fills happen at the first price at least this late (ms) after the decision
LAB_LATENCY_MS=600
# Optional latency grid: run every variant at several latencies (names become A@300, A@600)
# LAB_LATENCY_GRID=300,600,1200
# Status line target (ETA calculation in the 10-minute status line)
LAB_TARGET_TRADES=1000

# Replay / comparison strictness (bots/research/replay.mjs)
REPLAY_MIN_TRADES=300
REPLAY_TEST_FRACTION=0.7
REPLAY_RESAMPLES=2000

# Research lab overrides (optional): every variant is re-run with these exit rules on top
# LAB_TAKE_PROFIT=2.0
# LAB_STOP_LOSS=0.5
# LAB_TIMEOUT_SEC=120
# LAB_TIME_STOP_SEC=35

# Analytics
ANALYTICS_PORT=3000

# Volume analyzer: how many signature fetches run in parallel
CONCURRENCY=3

# Journal directory override (default data/journal) — used by the smoke test
# JOURNAL_DIR=data/journal

# Test-only fixtures: never set these in production, and they refuse to run with --live.
# WS_MOCK=scripts/mocks/ws-mock.mjs
# RPC_MOCK=scripts/mocks/rpc-mock.mjs
